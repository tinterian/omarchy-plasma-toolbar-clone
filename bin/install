#!/bin/bash
# One-time setup after cloning this repo to ~/.config/omarchy/plugins/spencer.bar:
#  - installs the post-boot and post-update hooks that keep the bar merged with
#    stock omarchy.bar and keep the blur block in hypr/looknfeel.lua
#  - adds that blur block now
#  - points shell.json at this bar (backs it up first) unless --no-select
# Safe to re-run.
set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
HOOKS=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks
SHELL_JSON=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json

for stage in post-boot post-update; do
  mkdir -p "$HOOKS/$stage.d"
  cat >"$HOOKS/$stage.d/spencer-bar-sync.hook" <<HOOK
#!/bin/bash
# Re-merge stock omarchy.bar into spencer.bar when Omarchy changes it.
# Installed for post-update and post-boot (boot catches plain \`pacman -Syu\`
# upgrades that bypass \`omarchy update\`). No-op when nothing changed.
# Installed by $REPO/bin/install
script="$REPO/bin/sync-upstream"
[[ -x \$script ]] && "\$script" --quiet
# Re-add the bar blur block to hypr/looknfeel.lua if a config reset removed it.
blur="$REPO/bin/ensure-hypr-blur"
[[ -x \$blur ]] && "\$blur" --quiet
exit 0
HOOK
  chmod +x "$HOOKS/$stage.d/spencer-bar-sync.hook"
done
echo "Installed hooks in $HOOKS/{post-boot,post-update}.d/"

"$REPO/bin/ensure-hypr-blur"

if [[ ${1:-} != --no-select && -f $SHELL_JSON ]]; then
  if python3 -c "import json,sys; sys.exit(0 if json.load(open('$SHELL_JSON')).get('bar',{}).get('id')=='spencer.bar' else 1)"; then
    echo "shell.json already uses spencer.bar"
  else
    cp "$SHELL_JSON" "$SHELL_JSON.bak.$(date +%s)"
    python3 - "$SHELL_JSON" <<'PY'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
d.setdefault("bar", {})["id"] = "spencer.bar"
json.dump(d, open(p, "w"), indent=2)
open(p, "a").write("\n")
PY
    echo "shell.json now uses spencer.bar (backup saved next to it)"
  fi
fi

omarchy restart shell >/dev/null 2>&1 || echo "Restart the shell to load the bar: omarchy restart shell"
